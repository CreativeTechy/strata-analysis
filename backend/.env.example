# --- Database ---
# The `db` service in docker-compose.yml creates the database and role from
# these, and the backend builds its connection string from the same values
# (backend/db.py), so the credentials are defined in exactly one place.
# POSTGRES_HOST is the compose service name - use localhost (or wherever
# Postgres actually listens) when running the backend outside Docker.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=strata
POSTGRES_USER=strata
POSTGRES_PASSWORD=strata
# Set this to point the backend at an already-provisioned database instead; it
# takes precedence over the POSTGRES_* values above (which the `db` service
# still reads).
# DATABASE_URL=postgresql://strata:strata@db:5432/strata

# Apply pending schema migrations on API startup (see backend/migrate.py).
# Set false to migrate out of band instead, e.g. from a deploy step.
# MIGRATE_ON_STARTUP=true

# -- LLM provider ---
# Supported values: ollama (default), openai, deepseek.
# This product analyzes documents the operator uploads, so it defaults to a
# model on their own hardware. Switching to a hosted provider means those
# documents leave the machine - a deliberate choice, not a default.
LLM_PROVIDER=ollama

# Ollama - the default. It exposes an OpenAI-compatible chat-completions
# endpoint, so no code changes are needed - just point OLLAMA_CHAT_BASE_URL at
# wherever it is actually running:
#   - bare-metal/venv backend + local `ollama serve`:
#     http://localhost:11434/v1/chat/completions
#   - docker compose backend + this repo's `ollama` service:
#     http://ollama:11434/v1/chat/completions - a localhost URL would resolve
#     to the backend container itself, not the ollama one.
#   - a remote/tunneled Ollama (e.g. ngrok in front of one on a GPU box, or a
#     RunPod serverless endpoint - https://api.runpod.ai/v2/<endpoint_id>/openai/v1/chat/completions):
#     that tunnel's HTTPS URL, with /v1/chat/completions appended.
# No real API key is required - Ollama ignores the Authorization header.
OLLAMA_API_KEY=ollama
OLLAMA_CHAT_BASE_URL=http://localhost:11434/v1/chat/completions
OLLAMA_CHAT_MODEL=Qwen/Qwen3-8B

# OpenAI - required when LLM_PROVIDER=openai.
# OPENAI_CHAT_BASE_URL points at the Responses API, not chat completions -
# leave this unless you know you need a different endpoint (e.g. Azure).
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_CHAT_BASE_URL=https://api.openai.com/v1/responses
# OPENAI_CHAT_MODEL=gpt-5-nano

# DeepSeek - required when LLM_PROVIDER=deepseek. Uses DeepSeek's
# OpenAI-compatible chat-completions API. "deepseek-chat"/"deepseek-reasoner"
# are deprecated legacy aliases; deepseek-v4-pro is the current model name.
# DEEPSEEK_API_KEY=your_deepseek_api_key
# DEEPSEEK_CHAT_BASE_URL=https://api.deepseek.com/v1/chat/completions
# DEEPSEEK_CHAT_MODEL=deepseek-v4-pro

# How long (seconds) a single chat_completion() HTTP call waits for a response
# before giving up. 60 is fine for a fast local model, but a large model on
# modest hardware - or a tunneled remote one - can genuinely take longer,
# especially with ANALYSIS_CONCURRENCY > 1 competing for the same GPU. Raise
# this rather than lowering concurrency alone if you see llm_timeout errors.
# This is the default for any chat_completion() call that doesn't set its own
# timeout (e.g. Intelligence Copilot chat) - the calls below get more time by
# default because they push more into the prompt/response than a plain reply.
# LLM_REQUEST_TIMEOUT_SECONDS=180
# PROJECT_METADATA_LLM_TIMEOUT_SECONDS=35
# BUSINESS_PROFILE_LLM_TIMEOUT_SECONDS=90
# PROJECT_DOCUMENT_SPLIT_TIMEOUT_SECONDS=90
# COMPETITOR_DOCUMENT_SPLIT_TIMEOUT_SECONDS=90
# COMPETITOR_NAMING_TIMEOUT_SECONDS=120
# COMPETITOR_FINDING_TIMEOUT_SECONDS=120

# Scope a different provider to just backend/services/competitors/ (document
# splitting, competitor naming, finding generation) without switching the rest
# of the app (article analysis, Copilot chat) over - e.g. a larger local model
# for the long reasoning finding generation does. Unset, it inherits
# LLM_PROVIDER above.
# COMPETITOR_ANALYSIS_LLM_PROVIDER=ollama

# Optional: local embedding model and runtime device
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu

# -- Similarity thresholds (optional) ---
# Cosine-similarity floors for the embedding-based attach-or-create/match
# decisions across the app (project attribution, search ranking, competitor
# mention matching, idea/segment clustering) - see config.py for what each one
# gates and why its default was picked. Conservative starting points, not
# empirically validated; uncomment to tune.
# PROJECT_ATTRIBUTION_SIMILARITY_THRESHOLD=0.78
# SEARCH_SEMANTIC_MATCH_THRESHOLD=0.78
# COMPETITOR_SEMANTIC_MATCH_THRESHOLD=0.62
# IDEA_SIMILARITY_THRESHOLD=0.86
# SEGMENT_SIMILARITY_THRESHOLD=0.80

# -- Hugging Face Inference API (optional) ---
# Only needed if SENTIMENT_CLASSIFIER_PROVIDER and/or CLASSIFICATION_PROVIDER
# below are set to hf_api - that runs those models through huggingface_hub's
# InferenceClient instead of loading them locally (no transformers/torch
# install needed in that mode, but the text does leave the machine).
# HF_API_TOKEN=your_huggingface_api_token

# Leave unset - InferenceClient routes to HF's current shared inference host
# itself. Only set this if you're pointing at your own dedicated HF
# Inference Endpoint URL instead.
# HF_API_BASE_URL=
# HF_API_TIMEOUT_SECONDS=30

# -- Sentiment Classifier ---
# Article sentiment always comes from this Hugging Face classifier, never the LLM.
# uncomment to override the defaults
SENTIMENT_CLASSIFIER_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
SENTIMENT_CLASSIFIER_DEVICE=cpu
SENTIMENT_CONFIDENCE_THRESHOLD=0.55
# local (default, runs SENTIMENT_CLASSIFIER_MODEL in-process) or hf_api (calls
# it through the Hugging Face Inference API above).
SENTIMENT_CLASSIFIER_PROVIDER=local

# --- Modular analysis pipeline (backend/analysis/) ---
# uncomment to override the defaults
CLASSIFICATION_MODEL=MoritzLaurer/mDeBERTa-v3-base-mnli-xnli
CLASSIFICATION_DEVICE=cpu
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.4
# local (default, runs CLASSIFICATION_MODEL in-process) or hf_api (calls it
# through the Hugging Face Inference API above).
CLASSIFICATION_PROVIDER=local
# Structured extraction runs through the LLM_PROVIDER above, not a local
# model - STRUCTURED_EXTRACTION_MODEL/_DEVICE are unused compatibility settings.
# Some models spend part of this budget on hidden reasoning before writing the
# visible JSON - too low a value here means every response gets cut off
# mid-JSON (finish_reason=length), llm_client's one built-in retry doubles the
# budget and tries again, and if that still isn't enough the article falls back
# to a failed/neutral analysis. Raise this rather than relying on the retry
# alone if you see analysis_error=model_unavailable at scale after switching
# models.
STRUCTURED_EXTRACTION_MAX_NEW_TOKENS=3000
STRUCTURED_EXTRACTION_TEMPERATURE=0.0
STRUCTURED_EXTRACTION_MAX_RETRIES=1
# Optional NER model; empty disables the stage (falls back to extraction's own entities).
# ENTITY_EXTRACTION_MODEL=
# ENTITY_EXTRACTION_DEVICE=cpu
# ENTITY_EXTRACTION_CONFIDENCE_THRESHOLD=0.5
# ANALYSIS_CHUNK_SIZE_CHARS=2000
# ANALYSIS_CHUNK_OVERLAP_CHARS=200
# ANALYSIS_MAX_INPUT_CHARS=20000

# --- Analysis concurrency ---
# How many articles one analysis run analyzes in parallel (see
# backend/services/pipeline/pipeline.py). Kept low because the ceiling with a
# local model is one model server, which also competes with the local embedding
# model for the same CPU/GPU. Raise it only after watching what your host
# actually sustains.
ANALYSIS_CONCURRENCY=4

# Same idea, for competitor-study finding generation (one LLM call per
# competitor - see backend/services/competitors/competitor_analysis.py).
# Independent of ANALYSIS_CONCURRENCY above: a different pipeline, its own
# workload shape, but the same underlying provider account/host.
# COMPETITOR_ANALYSIS_CONCURRENCY=4

# How long an analysis run may sit queued/running before a new run for the same
# project is allowed to start anyway - so a backend that died mid-run doesn't
# block that project forever.
# STALE_RUN_MINUTES=180

# --- Auth ---
# Bootstrap admin, created on first startup if the users table is empty.
# Set a real password before first boot - a known/guessable default here
# would be a live admin credential on any deployment that copies this file
# without changing it. Startup refuses to bootstrap with a known-weak value
# (see users_store.WEAK_BOOTSTRAP_PASSWORDS) rather than silently creating one.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=admin@strata.com
ADMIN_BOOTSTRAP_PASSWORD=change_me_before_first_boot
# Session cookie lifetime.
SESSION_TTL_HOURS=12
# Set to false only for plain-http local/dev deployments without TLS.
COOKIE_SECURE=true
# Origins allowed to make credentialed cross-origin requests (comma-separated).
# Same-origin deployments (the default, via nginx) don't need this at all.
CORS_ALLOWED_ORIGINS=http://localhost:5173
