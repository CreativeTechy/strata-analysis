# Copy to .env and fill in. The backend reads these via config.py.
# .env is gitignored - never commit real keys.

DATABASE_URL=postgresql://strata:strata@db:5432/strata
# DeepSeek key for event/source discovery; leave empty to disable those calls
DEEPSEEK_API_KEY=your-deepseek-key
# Local LLM for article enrichment and Intelligence Copilot
# Docker Compose uses the ollama service by default.
LOCAL_LLM_BASE_URL=http://ollama:11434/v1
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=qwen2.5:14b-instruct
# If you run the backend outside Docker, switch this to http://localhost:11434/v1
# and run Ollama on the host.
# Optional: local embedding model and runtime device
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu
# Optional: override feeds.txt at runtime (comma-separated)
# FEEDS=https://example.com/feed/,https://other.com/rss
