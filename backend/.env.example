DATABASE_URL=postgresql://strata:strata@db:5432/strata
# Apply pending schema migrations on API startup (see backend/migrate.py).
# Set false to migrate out of band instead, e.g. from a deploy step.
# MIGRATE_ON_STARTUP=true

# -- LLM provider ---
# Supported values: deepseek (default), openai, ollama
LLM_PROVIDER=deepseek

# OpenAI - required when LLM_PROVIDER=openai.
OPENAI_API_KEY=your_openai_api_key
# OPENAI_CHAT_BASE_URL points at the Responses API, not chat completions -
# leave this unless you know you need a different endpoint (e.g. Azure).
OPENAI_CHAT_BASE_URL=https://api.openai.com/v1/responses
OPENAI_CHAT_MODEL=gpt-5-nano

# DeepSeek - required when LLM_PROVIDER=deepseek (the default). Uses
# DeepSeek's OpenAI-compatible chat-completions API. "deepseek-chat" and
# "deepseek-reasoner" are deprecated legacy model aliases - deepseek-v4-pro
# is the current supported model name.
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_CHAT_BASE_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_CHAT_MODEL=deepseek-v4-pro

# Ollama - for LLM_PROVIDER=ollama, a fully offline/local option. Point this
# at a locally running `ollama serve` (default port 11434); it exposes an
# OpenAI-compatible chat-completions endpoint, so no code changes are needed.
# No real API key is required - Ollama ignores the Authorization header.
# OLLAMA_API_KEY=ollama
# OLLAMA_CHAT_BASE_URL=http://localhost:11434/v1/chat/completions
# OLLAMA_CHAT_MODEL=llama3.1

# Scope a different provider to just backend/services/competitors/ (document
# splitting, competitor naming, finding generation) without switching the
# rest of the app (enrichment, Copilot chat, discovery) over. Leave unset to
# inherit LLM_PROVIDER above - this is how you'd turn on Ollama for competitor
# analysis only, e.g.:
# COMPETITOR_ANALYSIS_LLM_PROVIDER=ollama

# Optional: local embedding model and runtime device
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu

# -- Hugging Face Inference API (optional) ---
# Only needed if SENTIMENT_CLASSIFIER_PROVIDER and/or CLASSIFICATION_PROVIDER below are set to hf_api - runs those models via huggingface_hub's
# InferenceClient instead of loading them locally (no transformers/torch install needed in that mode).
HF_API_TOKEN=your_huggingface_api_token

# Leave unset - InferenceClient routes to HF's current shared inference host
# itself. Only set this if you're pointing at your own dedicated HF
# Inference Endpoint URL instead.
# HF_API_BASE_URL=
# HF_API_TIMEOUT_SECONDS=30

# -- Sentiment Classifier ---
# Article sentiment always comes from this Hugging Face classifier, never the LLM.
# uncomment to override the defaults
SENTIMENT_CLASSIFIER_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
SENTIMENT_CLASSIFIER_DEVICE=cpu
SENTIMENT_CONFIDENCE_THRESHOLD=0.55
# local (default, runs SENTIMENT_CLASSIFIER_MODEL in-process) or hf_api (calls
# it through the Hugging Face Inference API above).
SENTIMENT_CLASSIFIER_PROVIDER=hf_api

# --- Modular analysis pipeline (backend/analysis/) ---
# uncomment to override the defaults
CLASSIFICATION_MODEL=MoritzLaurer/mDeBERTa-v3-base-mnli-xnli
CLASSIFICATION_DEVICE=cpu
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.4
# local (default, runs CLASSIFICATION_MODEL in-process) or hf_api (calls it
# through the Hugging Face Inference API above).
CLASSIFICATION_PROVIDER=hf_api
# Structured extraction runs through the LLM_PROVIDER above, not a local
# model - STRUCTURED_EXTRACTION_MODEL/_DEVICE are unused compatibility settings.
STRUCTURED_EXTRACTION_MAX_NEW_TOKENS=900
STRUCTURED_EXTRACTION_TEMPERATURE=0.0
STRUCTURED_EXTRACTION_MAX_RETRIES=1
# Optional NER model; empty disables the stage (falls back to extraction's own entities).
# ENTITY_EXTRACTION_MODEL=
# ENTITY_EXTRACTION_DEVICE=cpu
# ENTITY_EXTRACTION_CONFIDENCE_THRESHOLD=0.5
# ANALYSIS_CHUNK_SIZE_CHARS=2000
# ANALYSIS_CHUNK_OVERLAP_CHARS=200
# ANALYSIS_MAX_INPUT_CHARS=20000

# --- Scraping proxy (optional) ---
# Paid Proxy : Bright Data, Oxylabs, Smartproxy, IPRoyal, Webshare
# SCRAPE_PROXY_URL routes every source type (rss/web/keyword/social/etc.);
# REDDIT_PROXY_URL/TELEGRAM_PROXY_URL override it for just those platforms,
# e.g. to use a different proxy pool for them.
# SCRAPE_PROXY_URL=
# REDDIT_PROXY_URL=
# TELEGRAM_PROXY_URL=

# REDDIT_OAUTH_CLIENT_ID=
# REDDIT_OAUTH_CLIENT_SECRET=
# REDDIT_OAUTH_USER_AGENT=

# --- Google Custom Search (optional) ---
# General-web-search tier for "keyword" sources, alongside their Google News
# RSS feed - see backend/scraper/web_search.py. Create a Programmable Search
# Engine (scoped to the whole web) at https://programmablesearchengine.google.com/
# for GOOGLE_CSE_ENGINE_ID, and an API key with the Custom Search API enabled
# at https://console.cloud.google.com/apis/credentials. Free for 100
# queries/day, then billed. Unset (the default) skips this tier entirely.
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_ENGINE_ID=

# --- GDELT (optional, on by default) ---
# Free, no-key news-search tier for "keyword" sources, alongside their Google
# News RSS feed - see backend/scraper/gdelt.py. Set to false to disable.
GDELT_ENABLED=true

# --- Streaming enrichment concurrency ---
# How many articles are enriched (LLM + embedding calls) in parallel during a
# backend-triggered scrape - see backend/scraper/pipelines.py. Kept low by
# default since it needs to be safe across LLM_PROVIDER=deepseek/openai/ollama
# alike, not tuned to any one provider's ceiling - see config.py's own comment
# for the reasoning. Raise it if you've confirmed your provider/host can take
# more.
ENRICH_CONCURRENCY=4

# --- Auth ---
# Bootstrap admin, created on first startup if the users table is empty.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=admin@strata.com
ADMIN_BOOTSTRAP_PASSWORD=password
# Session cookie lifetime.
SESSION_TTL_HOURS=12
# Set to false only for plain-http local/dev deployments without TLS.
COOKIE_SECURE=true
# Origins allowed to make credentialed cross-origin requests (comma-separated).
# Same-origin deployments (the default, via nginx) don't need this at all.
CORS_ALLOWED_ORIGINS=http://localhost:5173
