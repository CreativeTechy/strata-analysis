# Copy to .env and fill in. The backend reads these via config.py.
# .env is gitignored — never commit real keys.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# service_role key — required for writes (bypasses RLS)
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
# DeepSeek key for AI enrichment; if unset, enrichment uses neutral defaults
DEEPSEEK_API_KEY=your-deepseek-key
# Optional: local embedding model and runtime device
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu
# Optional: override feeds.txt at runtime (comma-separated)
# FEEDS=https://example.com/feed/,https://other.com/rss
