# Copy to .env and fill in. The backend reads these via config.py.
# .env is gitignored - never commit real keys.

DATABASE_URL=postgresql://strata:strata@db:5432/strata
# DeepSeek key, required for article enrichment, Intelligence Copilot chat,
# and project/source discovery.
DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_CHAT_BASE_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_CHAT_MODEL=deepseek-chat
# Optional: local embedding model and runtime device
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu
# Optional: override configured sources at runtime (comma-separated)
# SOURCES=https://example.com/feed/,https://other.com/rss

# --- Auth ---
# Bootstrap admin, created on first startup if the users table is empty.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-now
# Session cookie lifetime.
SESSION_TTL_HOURS=12
# Set to false only for plain-http local/dev deployments without TLS.
COOKIE_SECURE=true
# Origins allowed to make credentialed cross-origin requests (comma-separated).
# Same-origin deployments (the default, via nginx) don't need this at all.
CORS_ALLOWED_ORIGINS=http://localhost:5173
