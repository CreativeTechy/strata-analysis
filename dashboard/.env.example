# Copy to .env to override defaults.

# Backend base URL for the dev proxy (/scrape, /api). Defaults to localhost:8000.
# VITE_API_TARGET=http://localhost:8000

# Spider Mode backend (Hugging Face Space). Empty in dev (uses the Vite proxy).
# In production set this to your Space URL so the deployed dashboard reaches it.
# VITE_SPIDER_URL=https://your-user-strata-spider.hf.space
